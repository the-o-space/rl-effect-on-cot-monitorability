REGISTRY_USER=ghcr.io/<github-username>

# Logfire environment name (e.g., your name or team name)
LOGFIRE_ENVIRONMENT=<your-name>

# Logfire write token for logging and observability
# Find it at https://logfire-us.pydantic.dev/<your-project>/settings/write-tokens
LOGFIRE_TOKEN=<logfire-api-token-here>

# OpenRouter API key for baseline model evaluation
# Find it at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=<openrouter-api-token-here>
